# ============================================================
# 这个 .env 只在「本地开发」(npm run dev) 和「构建打包」(npm run build) 时用。
# 正式部署改的是 deploy/config.json（运行时读取，不用重新打包）——见 deploy/README.md。
# 优先级：运行时 config.json > 这里的 VITE_*。
# ============================================================

# 数据源：static（默认，catalog.json + 对象存储）或 jellyfin（自建媒体服务器）
VITE_SOURCE=static


# ---------- static 源 ----------
# 视频与封面所在的对象存储 / CDN 根地址（阿里云 OSS、腾讯云 COS、七牛均可）。末尾不要带斜杠。
VITE_CDN_BASE=
VITE_CATALOG_PATH=catalog.json
# 部署到子路径时设置，例如 /childvideo/
VITE_PUBLIC_BASE=/


# ---------- jellyfin 源（本地开发用；线上用 deploy/config.json） ----------
VITE_JELLYFIN_BASE=/jf
VITE_JELLYFIN_KEY=
VITE_JELLYFIN_USER_ID=
VITE_JELLYFIN_LIBRARY_ID=
VITE_JELLYFIN_CATEGORY_MODE=genre
VITE_JELLYFIN_STREAM=direct
# 仅本地开发：dev server 把 /jf 代理到这个 Jellyfin 源站，绕开 CORS
VITE_JELLYFIN_ORIGIN=http://localhost:8096
