# ============================================================
# 数据源：static（默认，catalog.json + 对象存储）或 jellyfin（自建媒体服务器）
# ============================================================
VITE_SOURCE=static


# ---------- static 源 ----------
# 视频与封面所在的对象存储 / CDN 根地址（阿里云 OSS、腾讯云 COS、七牛均可）
# catalog.json 及全部资源都相对该地址解析。末尾不要带斜杠。
VITE_CDN_BASE=
# 目录文件名（可选）
VITE_CATALOG_PATH=catalog.json
# 部署到子路径时设置，例如 /childvideo/
VITE_PUBLIC_BASE=/


# ---------- jellyfin 源 ----------
# 设 VITE_SOURCE=jellyfin 时生效。
# 反代后同源地址，配合 deploy/nginx.conf 用 /jf；开发时可写完整 http(s) 地址。
VITE_JELLYFIN_BASE=/jf
# 在 Jellyfin 控制台 - API 密钥 里生成
VITE_JELLYFIN_KEY=
# 儿童账号的用户 ID：控制台 - 用户 - 点开该用户，地址栏 userId=... 即是
VITE_JELLYFIN_USER_ID=
# 只读取这个媒体库（CollectionFolder 的 Id）；留空则读取该用户能看到的全部库
VITE_JELLYFIN_LIBRARY_ID=
# 分类来源：genre = 用视频的第一个「类型/Genre」当分类（入库 CLI 会写好）；
#           collection = 用合集(BoxSet)当分类
VITE_JELLYFIN_CATEGORY_MODE=genre
# 播放方式：direct = 原样直连（推荐，入库已转成 web 友好 mp4）；hls = 让 Jellyfin 转码切片
VITE_JELLYFIN_STREAM=direct
# 仅本地开发用：dev server 把 /jf 代理到这个 Jellyfin 源站，绕开 CORS
VITE_JELLYFIN_ORIGIN=http://localhost:8096
