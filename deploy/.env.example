# docker compose 用。cp .env.example .env 后按需修改。

# 儿童端 nginx 对外端口。NAS 的 80/443 常被管理界面占用，默认 8080。
WEB_PORT=8080

# nginx 反代的 Jellyfin 地址。
#   已有 Jellyfin（用法 A）：指向它，例如 http://192.168.1.50:8096
#                            （容器网络里也可试 http://host.docker.internal:8096）
#   全新一起起（用法 B）：   保持 http://jellyfin:8096
JF_UPSTREAM=http://jellyfin:8096

# --- 下面几项仅「用法 B」(docker compose --profile bundled) 用到 ---
PUID=1000
PGID=1000
TZ=Asia/Shanghai
# 自带 Jellyfin 的端口绑定：家庭 NAS 用 0.0.0.0:8096；公网服务器用 127.0.0.1:8096
JELLYFIN_BIND=0.0.0.0:8096
