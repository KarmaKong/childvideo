# 同源反代：/ 出儿童前端静态包，/jf/ 转发到 Jellyfin（绕开 CORS）
# ${JF_UPSTREAM} 由 compose 注入（NGINX_ENVSUBST_FILTER=^JF_ 只替换 JF_ 开头的变量，
# 其余 $host / $http_upgrade 等 nginx 变量原样保留）。
# Jellyfin 以默认根路径运行，这里把 /jf/ 前缀剥掉再转发。

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    # 播放大文件时关闭响应缓冲
    proxy_buffering off;
    client_max_body_size 20m;

    # ---- 儿童前端（SPA，history 路由回退） ----
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # 静态资源缓存
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # ---- Jellyfin API（前端只用到这些） ----
    # 注意结尾的斜杠：会把 /jf/ 前缀剥掉，Jellyfin 收到的是 /Users/... /Videos/...
    location /jf/ {
        proxy_pass ${JF_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_read_timeout 3600s;
    }

    # 管理台不经此处开放（就用 Jellyfin 自己的 http://NAS:8096）。
    location ~ ^/jf/(web|dashboard) {
        return 404;
    }
}
